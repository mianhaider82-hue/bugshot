# Claude API key (https://platform.claude.com). Alternatively run `ant auth login`.
ANTHROPIC_API_KEY=
# Model used for analysis (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

PORT=4000
# Public URL of this server – must match the OAuth redirect URI registered in
# Google Cloud: <PUBLIC_URL>/api/auth/google/callback
PUBLIC_URL=http://localhost:4000

# Google Cloud OAuth client (type "Web application"); enable the Sheets + Drive APIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: lock the API to your extension ID(s), comma-separated (chrome://extensions)
# ALLOWED_EXTENSION_IDS=
# DATA_DIR=./data
