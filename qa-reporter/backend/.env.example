# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Model used for analysis (default gpt-4o)
# OPENAI_MODEL=gpt-4o

# Cloudinary account for screenshot storage (Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder screenshots are uploaded to (default qa-reporter)
# CLOUDINARY_FOLDER=qa-reporter

PORT=4000
# Public URL of this server – must match the OAuth redirect URI registered in
# Google Cloud: <PUBLIC_URL>/api/auth/google/callback
PUBLIC_URL=http://localhost:4000

# Google Cloud OAuth client (type "Web application"); enable the Sheets + Drive APIs (Drive is only used to list spreadsheets).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: lock the API to your extension ID(s), comma-separated (chrome://extensions)
# ALLOWED_EXTENSION_IDS=
# DATA_DIR=./data
